{
  "name": "sucai",
  "version": "1.0.0",
  "description": "素材搜索下载器",
  "author": "Sucai",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/check-downloads.cjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5188 && electron . --dev\"",
    "package": "npm run build && electron-builder --win",
    "agent:serve": "node agent/server.mjs",
    "agent:mcp": "node agent/mcp-server.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  }
}
